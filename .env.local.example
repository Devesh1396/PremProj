# LOCAL DEVELOPMENT ONLY — copy to .env.local.
#
#   docker compose -f docker-compose.local.yml --env-file .env.local up -d
#   bash scripts/local_db_setup.sh
#
# This is NOT .env. `.env` is the VPS deployment file described in
# docs/OPERATIONS.md and is read by docker-compose.yml; keeping the local
# stack on its own env file means a laptop password can never be picked up
# by a production `docker compose up`.
#
# The passwords below are deliberately weak and committed as an example.
# That is safe only because this database holds SYNTHETIC DATA ONLY and
# listens on 127.0.0.1. Never put real client information in it.

# ---------------------------------------------------------------
# Database (matches docker-compose.local.yml defaults)
# ---------------------------------------------------------------
POSTGRES_DB=phi

POSTGRES_ADMIN_USER=phi_admin
POSTGRES_ADMIN_PASSWORD=localdev

# Created by migration 005 with no password. scripts/local_db_setup.sh
# sets these two afterwards, exactly as OPERATIONS.md step 5 does on the VPS.
POSTGRES_RUNTIME_USER=phi_runtime
POSTGRES_RUNTIME_PASSWORD=localdev_runtime

POSTGRES_PRACTITIONER_USER=phi_practitioner
POSTGRES_PRACTITIONER_PASSWORD=localdev_practitioner

# Loopback-published, on a non-default port so it cannot collide with a
# Postgres already installed on the machine.
POSTGRES_HOST=127.0.0.1
POSTGRES_LOCAL_PORT=55432
POSTGRES_PORT=55432

# What migrate.py and the test suites connect with. Admin role: migrations
# and fixtures. The suites derive the runtime and practitioner DSNs from
# this one by substituting the username, so RLS is exercised as the roles
# that actually enforce it.
DATABASE_URL=postgresql://phi_admin:localdev@127.0.0.1:55432/phi

# ---------------------------------------------------------------
# LLM provider — leave EMPTY for local work
# ---------------------------------------------------------------
# Empty LLM_API_KEY keeps run_engine.py on the deterministic fixture
# provider, which is what makes the whole orchestration testable with no
# credentials and no spend. Fill these in only for a deliberate live
# measurement run; see BUILD_GUIDE.md step 10b.
LLM_BASE_URL=
LLM_API_KEY=

MODEL_ANALYSIS=
MODEL_EXTRACTION=
MODEL_RESEARCH=
MODEL_EMBEDDING=
MODEL_FAST=

EMBEDDING_DIM=1536
VECTOR_ENABLED=true

# Rates come from config/model_prices.json. A model with no rate is
# UNPRICED and its cost is NULL, never 0. Set BOTH of these to price a
# model that is not in the registry yet.
MODEL_PRICE_FILE=
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# ---------------------------------------------------------------
# Concept governance / privacy / cost — same values as .env.example
# ---------------------------------------------------------------
CONCEPT_AUTO_ALIAS_THRESHOLD=0.92
CONCEPT_AUTO_CREATE_THRESHOLD=0.72
CONCEPT_ESCALATION_WEEKLY_CAP=15

STRIP_IDENTITY_FROM_ENGINE_PAYLOADS=true

KNOWLEDGE_DAILY_TOKEN_BUDGET=
KNOWLEDGE_BATCH_SIZE=25
KNOWLEDGE_MAX_CONCURRENCY=3
