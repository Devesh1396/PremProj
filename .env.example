# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with:  openssl rand -hex 32

# ---------------------------------------------------------------
# Docker
# ---------------------------------------------------------------
# The existing n8n Docker network on this VPS. Find it with:
#   docker inspect <n8n-container> -f '{{json .NetworkSettings.Networks}}'
N8N_NETWORK=root_default

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
POSTGRES_DB=phi

# Admin role: owns the schema, runs migrations. NOT used at runtime.
POSTGRES_ADMIN_USER=phi_admin
POSTGRES_ADMIN_PASSWORD=

# Runtime role: what n8n connects as. RLS enforced, NOSUPERUSER,
# NOBYPASSRLS. Created by migration 005; set its password with
#   ALTER ROLE phi_runtime WITH PASSWORD '...';
POSTGRES_RUNTIME_USER=phi_runtime
POSTGRES_RUNTIME_PASSWORD=

# Review surface: the one deliberate cross-client READ path.
POSTGRES_PRACTITIONER_USER=phi_practitioner
POSTGRES_PRACTITIONER_PASSWORD=

# Host is the container name on the shared Docker network. There is no
# published port; nothing outside the network can connect.
POSTGRES_HOST=phi-postgres
POSTGRES_PORT=5432

# For running migrations from the host (admin role, inside the container).
DATABASE_URL=postgresql://phi_admin:CHANGEME@phi-postgres:5432/phi

# ---------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------
# Any OpenAI-compatible endpoint. Provider is abstracted: switching is an
# .env edit, never a code change. cost_events records model_name per call
# so providers can be compared on measured data.
#
# Gemini exposes an OpenAI-compatible endpoint; verify the current base
# URL in Google's docs when wiring it.
LLM_BASE_URL=
LLM_API_KEY=

# ---------------------------------------------------------------
# Model roles — NEVER hard-code a model name in a workflow
# ---------------------------------------------------------------
# MODEL_ANALYSIS   engines 1-6. Quality matters most.
# MODEL_EXTRACTION claim/evidence extraction. Highest volume: keep cheap.
# MODEL_RESEARCH   synthesis, merge decisions, controversy analysis.
# MODEL_EMBEDDING  vector index.
# MODEL_FAST       normalization, classification, routing helpers.
MODEL_ANALYSIS=
MODEL_EXTRACTION=
MODEL_RESEARCH=
MODEL_EMBEDDING=
MODEL_FAST=

# Must match the vector column width in migrations 002 and 003.
# Changing this requires a migration and a full re-embed.
EMBEDDING_DIM=1536

# ---------------------------------------------------------------
# Pricing — how a token count becomes a cost
# ---------------------------------------------------------------
# Rates live in config/model_prices.json, a registry keyed by model name.
# Adding a model's price is a data edit, never a code change, and the model
# ROLES above still decide which model runs.
#
# A model with no rate is UNPRICED: cost_usd stays NULL and the measurement
# report says the price is not configured. It is never recorded as 0 --
# ck_cost_priced rejects that pairing, because a zero would read as "this
# call was free".
#
# Point MODEL_PRICE_FILE elsewhere to override the file. The two rates
# below are an escape hatch for a provider not yet in the registry: set
# BOTH and they apply to whatever model runs. Leave empty otherwise.
MODEL_PRICE_FILE=
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# ---------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------
# Set false if pgvector is unavailable. Retrieval degrades to metadata
# filters + full-text + trigram and still functions.
VECTOR_ENABLED=true

# ---------------------------------------------------------------
# Concept governance
# ---------------------------------------------------------------
CONCEPT_AUTO_ALIAS_THRESHOLD=0.92
CONCEPT_AUTO_CREATE_THRESHOLD=0.72
# Hard cap on practitioner escalations per week. Items over the cap stay
# queued and re-rank; they are never dropped.
CONCEPT_ESCALATION_WEEKLY_CAP=15

# ---------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------
# Database and VPS are in India. Model inference is not. Strip identity
# from engine payloads: engines need clinical facts and client_id, never
# names. Leave true unless you have a specific reason.
STRIP_IDENTITY_FROM_ENGINE_PAYLOADS=true

# ---------------------------------------------------------------
# Cost control — 2 vCPU VPS: keep concurrency low
# ---------------------------------------------------------------
KNOWLEDGE_DAILY_TOKEN_BUDGET=
KNOWLEDGE_BATCH_SIZE=25
KNOWLEDGE_MAX_CONCURRENCY=3

# ---------------------------------------------------------------
# Research sources
# ---------------------------------------------------------------
NCBI_API_KEY=
NCBI_EMAIL=

# ---------------------------------------------------------------
# Backups
# ---------------------------------------------------------------
# Encrypted nightly dump. A VPS has no backups by default.
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30
BACKUP_GPG_RECIPIENT=
BACKUP_REMOTE_TARGET=
